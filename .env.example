# Local env template. `vercel env pull .env.local` fills these from the
# Vercel project; copy this file to `.env.local` instead to fill it by hand.

# Firebase web app credentials (removed in M6).
# Vite only exposes vars prefixed with VITE_ to the client.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only: read inside /api and scripts/. Never prefix these with VITE_,
# which would ship them in the client bundle. Set by the Neon integration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
