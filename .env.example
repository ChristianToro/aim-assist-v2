# Local env template. `vercel env pull .env.local` fills these from the
# Vercel project; copy this file to `.env.local` instead to fill it by hand.

# Neon Auth (set by the Neon integration). Public URLs, not secrets:
# the server fetches signing keys from the first, the client signs in
# through the second. Vite only exposes VITE_-prefixed vars to the client.
NEON_AUTH_BASE_URL=
VITE_NEON_AUTH_URL=

# Server-only: read inside /api and scripts/. Never prefix these with VITE_,
# which would ship them in the client bundle. Set by the Neon integration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Anthropic API key for the AI insights (/api/insights/*). Set it by hand
# in Vercel (Production, Preview and Development), then `vercel env pull`.
ANTHROPIC_API_KEY=
