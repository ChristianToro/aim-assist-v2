  {
    "id": "f_commit",
    "type": "function",
    "z": "lbwatch",
    "name": "Save on 2xx",
    "func": "// Save the new #1 only once Discord accepted the post, so a failed post\n// is tried again at the next check.\nconst time = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })\nif (msg.statusCode >= 200 && msg.statusCode < 300) {\n  flow.set(msg.stateKey, msg.nextState, 'file')\n  node.status({ fill: 'green', shape: 'dot', text: `${msg.view}: posted ${msg.event.kind} at ${time}` })\n  node.log(`${msg.view}: posted ${msg.event.kind}`)\n} else {\n  node.status({ fill: 'red', shape: 'ring', text: `${msg.view}: post failed (${msg.statusCode}) at ${time}` })\n  node.warn(`${msg.view}: Discord post failed (${msg.statusCode}), will retry at the next check`)\n}\nreturn null",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 2130,
    "y": 140,
    "wires": [[]]
  },
