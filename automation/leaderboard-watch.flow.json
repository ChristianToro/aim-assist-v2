  {
    "id": "f_request",
    "type": "function",
    "z": "lbwatch",
    "name": "Leaderboard request",
    "func": "// GET /api/leaderboard for msg.view, from the app at AIM_ASSIST_URL.\nmsg.url = `${env.get('AIM_ASSIST_URL')}/api/leaderboard?view=${encodeURIComponent(msg.view)}`\nmsg.requestTimeout = 10000\ndelete msg.payload\nreturn msg",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 140,
    "wires": [["h_get"]]
  },
  {
    "id": "h_get",
    "type": "http request",
    "z": "lbwatch",
    "name": "GET leaderboard",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 610,
    "y": 140,
    "wires": [["f_decide"]]
  },
  {
    "id": "f_decide",
    "type": "function",
    "z": "lbwatch",
    "name": "Decide",
    "func": "// Change detection lives in the repo: automation/watcher/decide.js.\nconst watcher = global.get('watcher')\nif (!watcher) {\n  node.error('Watcher not loaded: set AIM_ASSIST_WATCHER in ~/.node-red/.env and restart', msg)\n  return null\n}\nconst time = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })\nif (msg.statusCode !== 200 || !Array.isArray(msg.payload?.entries)) {\n  node.status({ fill: 'red', shape: 'ring', text: `${msg.view}: fetch failed (${msg.statusCode}) at ${time}` })\n  node.warn(`${msg.view}: leaderboard fetch failed (${msg.statusCode}), state unchanged`)\n  return null\n}\n\nconst key = `top_${msg.view}`\nconst { action, state, event } = watcher.decide({\n  saved: flow.get(key, 'file'),\n  entries: msg.payload.entries,\n  view: msg.view,\n})\nconst alert = watcher.ALERTS.includes(action)\nnode.status({ fill: alert ? 'yellow' : 'green', shape: 'dot', text: `${msg.view}: ${action} at ${time}` })\nnode.log(`${msg.view}: ${action}`)\n\nif (action === 'none') return null\n// No alert: save now. An alert saves only once Discord accepts it.\nif (!alert) {\n  flow.set(key, state, 'file')\n  return null\n}\nreturn { view: msg.view, stateKey: key, nextState: state, event }",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 780,
    "y": 140,
    "wires": [["f_claude", "d_event"]]
  },
  {
    "id": "d_event",
    "type": "debug",
    "z": "lbwatch",
    "name": "alert event",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "event",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 980,
    "y": 100,
    "wires": []
  },
  {
    "id": "f_claude",
    "type": "function",
    "z": "lbwatch",
    "name": "Flags + Claude request",
    "func": "// The AI step: rule flags, then the Messages API request. The request is\n// built in the repo (automation/watcher/claude.js); Claude sees figures\n// only, never a player's name.\nconst watcher = global.get('watcher')\nmsg.flags = watcher.ruleFlags(msg.event)\nmsg.url = watcher.MESSAGES_URL\nmsg.headers = {\n  'content-type': 'application/json',\n  'x-api-key': env.get('ANTHROPIC_API_KEY'),\n  'anthropic-version': watcher.API_VERSION,\n}\nmsg.payload = watcher.claudeRequest(watcher.claudeInput(msg.event, msg.flags))\nmsg.requestTimeout = 30000\nreturn msg",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1000,
    "y": 140,
    "wires": [["h_claude"]]
  },
  {
    "id": "h_claude",
    "type": "http request",
    "z": "lbwatch",
    "name": "POST Claude",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 1190,
    "y": 140,
    "wires": [["f_merge"]]
  },
  {
    "id": "f_merge",
    "type": "function",
    "z": "lbwatch",
    "name": "Merge verdict",
    "func": "// Rule flags plus Claude's verdict give the label and the post. Without a\n// verdict (an error, a refusal, bad JSON) the rules alone decide.\nconst watcher = global.get('watcher')\nconst verdict = msg.statusCode === 200 ? watcher.parseVerdict(msg.payload) : null\nif (verdict) {\n  const usage = msg.payload.usage ?? {}\n  node.log(`${msg.view}: Claude says ${verdict.label} (${usage.input_tokens} in, ${usage.output_tokens} out)`)\n} else {\n  node.warn(`${msg.view}: no verdict from Claude (${msg.statusCode}), the rules decide`)\n}\nconst { label, payload } = watcher.alertPost({ event: msg.event, flags: msg.flags, verdict })\nnode.status({ fill: label === 'review' ? 'yellow' : 'green', shape: 'dot', text: `${msg.view}: ${label}${verdict ? '' : ' (rules only)'}` })\n// A fresh message, so the API key header goes no further.\nreturn {\n  view: msg.view,\n  stateKey: msg.stateKey,\n  nextState: msg.nextState,\n  event: msg.event,\n  flags: msg.flags,\n  verdict,\n  label,\n  payload,\n  headers: { 'content-type': 'application/json' },\n  requestTimeout: 10000,\n}",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1360,
    "y": 140,
    "wires": [["s_route", "d_verdict"]]
  },
